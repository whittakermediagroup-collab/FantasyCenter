{
  "name": "draft-command",
  "version": "1.0.0",
  "private": true,
  "description": "Fantasy football draft assistant with a daily-refreshed injury board.",
  "scripts": {
    "build": "esbuild app.jsx --bundle --format=iife --outfile=dist/app.js --minify",
    "build-css": "tailwindcss -c tailwind.config.js -i src/tailwind-input.css -o dist/tailwind.css --minify",
    "build-fonts": "node scripts/build-fonts.mjs",
    "update-injuries": "node scripts/update-injuries.mjs",
    "update-adp": "node scripts/update-adp.mjs",
    "update-teams": "node scripts/update-teams.mjs",
    "update-durability": "node scripts/update-durability.mjs",
    "update-usage": "node scripts/update-usage.mjs",
    "update-fantasypros-adp": "node scripts/update-fantasypros-adp.mjs",
    "update-rookies": "node scripts/update-rookies.mjs",
    "dev-build": "esbuild app.jsx --bundle --format=iife --outfile=dist/app.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.14",
    "@fontsource/oswald": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0"
  }
}
